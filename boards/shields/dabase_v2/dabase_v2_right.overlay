#include "dabase_v2.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <input/processors.dtsi>

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                    <NRF_PSEL(TWIM_SCL, 0, 20)>;
        };
    };
    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                    <NRF_PSEL(TWIM_SCL, 0, 20)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <100000>;

    trackball: trackball@42 {
        compatible = "promini,trackpoint-i2c";
        reg = <0x42>;
        swap-xy;
        speed-scale = <10>;
    };
};

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    diode-direction = "col2row";
    col-gpios
        = <&gpio0 2  GPIO_ACTIVE_HIGH>
        , <&gpio0 29 GPIO_ACTIVE_HIGH>
        , <&gpio0 9  GPIO_ACTIVE_HIGH>
        , <&gpio1 0  GPIO_ACTIVE_HIGH>
        , <&gpio1 4  GPIO_ACTIVE_HIGH>
        , <&gpio1 11 GPIO_ACTIVE_HIGH>
    ;

    row-gpios
        = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio1 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    ;
};

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball_split>;

        scroll_override {
            layers = <5>;
            input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>, <&zip_scroll_scaler 1 20>;
        };

        // Exp51: hold K (layer 7) -> trackpoint tilt becomes volume.
        // Y-invert to match scroll's physical-up mapping (up = louder).
        // Keybind override first (process-next so the zero scaler can run after),
        // then scale X/Y to 0 so the cursor stays put on layer 7.
        volume_override {
            layers = <7>;
            input-processors = <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>, <&keybind_volume>;
            process-next;
        };

        volume_move_zero {
            layers = <7>;
            input-processors = <&zip_xy_scaler 0 1>;
        };
    };

    keybind_volume: keybind_volume {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        mode = <0>;
        track_remainders;
        // order: RIGHT, LEFT, DOWN, UP (per press_work_cb)
        bindings = <&none>, <&none>, <&kp C_VOLUME_DOWN>, <&kp C_VOLUME_UP>;
        tick = <32>;
        wait-ms = <10>;
        tap-ms = <12>;
        threshold = <1>;
        max_threshold = <512>;
        max_pending_activations = <2>;
    };
};

#ifdef CONFIG_ZMK_SPLIT_ROLE_CENTRAL
&trackball_listener {
    device = <&trackball>;
    status = "okay";
};
#else
&trackball_split {
    device = <&trackball>;

    scroll_override {
        layers = <5>;
        input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>, <&zip_scroll_scaler 1 20>;
    };
};
#endif

/ {
    EXT_POWER {
        control-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>,   /* PNP base: LOW = VCC to Pro Mini */
                        <&gpio0 6 GPIO_ACTIVE_HIGH>,  /* NPN base: HIGH = GND to Pro Mini */
                        <&gpio0 13 GPIO_ACTIVE_HIGH>; /* nice_nano VCC rail switch - keep on */
        init-delay-ms = <500>;
    };
};
