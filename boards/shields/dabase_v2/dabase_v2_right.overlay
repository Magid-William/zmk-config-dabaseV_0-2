#include "dabase_v2.dtsi"


&default_transform {
    col-offset = <6>;
};

&kscan0 {
    diode-direction = "col2row";
    col-gpios
        = <&gpio0 2  GPIO_ACTIVE_HIGH>
        , <&gpio0 29 GPIO_ACTIVE_HIGH>
        , <&gpio0 9  GPIO_ACTIVE_HIGH>
        , <&gpio1 0  GPIO_ACTIVE_HIGH>
        , <&gpio1 4  GPIO_ACTIVE_HIGH>
        , <&gpio1 11 GPIO_ACTIVE_HIGH>
    ;

	row-gpios
		= <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio1 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
	;
};

/ {
	gpio_ps2: gpio_ps2 {
		status = "okay";
		compatible = "gpio-ps2";
		scl-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
		sda-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
	};

	mouse_ps2: mouse_ps2 {
		status = "okay";
		compatible = "zmk,input-mouse-ps2";
		ps2-device = <&gpio_ps2>;
	};

	mouse_ps2_input_listener: mouse_ps2_input_listener {
		compatible = "zmk,input-listener-ps2";
		status = "okay";
		device = <&mouse_ps2>;
	};
};
