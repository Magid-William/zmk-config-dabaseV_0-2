 * SPDX-License-Identifier: MIT
 *
 * Exp69 fresh: direct PS/2 trackpoint (gpio-ps2) on the right half —
 * no ATtiny/Pro Mini coprocessor. See dabase-v2-right-ps2.dtsi.
 */

#include "dabase_v2.dtsi"
#include "dabase-v2-right-ps2.dtsi"
#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>

/* Exp74: on-device PowerCurve (RawAccel-style, ported from the AVR library).
 * Same tuning as the coprocessor era (Exp60/61 known-good): sens 0.5x,
 * rate 0.070, exp 1.0, start 0.30 -> slow nudge < 1x gain (precise crawl),
 * fast flick > 1x. curve-rate != 0 = curve enabled (driver default is off).
 * Tuning = edit these, rebuild the right half, flash (like the old I2C path). */
&tpoint0 {
    curve-sens = <128>;
    curve-rate = <18>;
    curve-exponent = <256>;
    curve-start = <77>;
};

/* Exp71: direction fix - the TP's sensor axes are rotated vs the mount
 * (nub up -> cursor left, nub left -> cursor up). Apply the inverse in
 * software. Iteration 1 was swap+invert-both (=7) which OVER-corrected
 * (up->down, left->right): this TP's raw/screen sign convention already
 * matches, so the correction is SWAP ONLY. The TP rejects host commands,
 * so its register invert/swap bits are no-ops. The transform runs on the
 * right half before split-forward (peripheral) or before HID
 * (standalone-central listener).
 */
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    diode-direction = "col2row";
    col-gpios
        = <&gpio0 2  GPIO_ACTIVE_HIGH>
        , <&gpio0 29 GPIO_ACTIVE_HIGH>
        , <&gpio0 9  GPIO_ACTIVE_HIGH>
        , <&gpio1 0  GPIO_ACTIVE_HIGH>
        , <&gpio0 11 GPIO_ACTIVE_HIGH>
        , <&gpio1 4  GPIO_ACTIVE_HIGH>
    ;

    row-gpios
        = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    ;
};

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&tpoint0>;
    };
};

#ifdef CONFIG_ZMK_SPLIT_ROLE_CENTRAL
/* Exp82: no dongle - the right half IS the split central, so the pointer
 * pipeline that used to live on the dongle listener runs here: touch the TP
 * -> tp_layer (5) for MB1/MB2/MB3, hold J (6) -> scroll, hold K (7) -> volume.
 * The swap transform stays FIRST so the corrected axes feed the processors. */
&trackball_listener {
    status = "okay";
    /* Exp72/Exp78: touch the TP -> layer 5 (tp_layer), giving MB1/MB2/MB3
     * on the right thumb cluster. Exp80 tuning: 150 ms idle timeout holds
     * the layer through a normal pause between nudges yet drops it well
     * before a thumb keypress. NB: the processor special-cases 0 as
     * "no auto-release" (layer sticks), so a non-zero timeout is used. */
    input-processors = <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP)>, <&tp_temp_layer 5 150>;

    scroll_override {
        layers = <6>;
        /* swap FIRST: overrides run before the base list, and the dongle used
         * to receive already-swapped events from the right half.
         * Exp83: scroll felt slow at 1:2 (values halved), then still slow at
         * 1:1. Now 12:1 = 12x the previous speed (24x the original 1:2).
         * Tune the scaler mul/div: 6:1 = half of this, 1:1 = 1x, 1:2 = old. */
        input-processors = <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP)>, <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>, <&zip_scroll_scaler 12 1>;
        process-next;
    };

    /* Exp73: hold K (layer 7) -> trackpoint tilt becomes volume.
     * Y-invert so up = louder. Keybind override first (process-next), then
     * scale X/Y to 0 so the cursor stays put on layer 7 (the keybind's STOP
     * is honored because volume_move_zero has no process-next). */
    volume_override {
        layers = <7>;
        /* same swap-first rule as scroll_override (old dongle input was
         * pre-swapped), then the original Y-invert so up = louder;
         * volume_move_zero eats the leftover movement. */
        input-processors = <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP)>, <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>, <&keybind_volume>;
        process-next;
    };

    volume_move_zero {
        layers = <7>;
        input-processors = <&zip_xy_scaler 0 1>;
    };
};

/ {
    tp_temp_layer: tp_temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        status = "okay";
    };

    /* Exp73: volume keybind - defined inline (the module's own dtsi pulls
     * <dt-bindings/zmk/input-processor-keybind.h>, missing from ZMK + the
     * module). Bindings order is [RIGHT, LEFT, DOWN, UP] per press_work_cb:
     * X mapped to &none so only Y produces volume. tick 32 = very slow. */
    keybind_volume: keybind_volume {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        mode = <0>;
        track_remainders;
        bindings = <&none>, <&none>, <&kp C_VOLUME_DOWN>, <&kp C_VOLUME_UP>;
        tick = <32>;
        wait-ms = <10>;
        tap-ms = <12>;
        threshold = <1>;
        max_threshold = <512>;
        max_pending_activations = <2>;
    };
};
#else
/* BLE peripheral: forward direct-PS2 input to the central (right half).
 * The split node runs its input-processors BEFORE forwarding, so the
 * corrected events land on the central (no central-side change needed). */
&trackball_split {
    device = <&tpoint0>;
    input-processors = <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP)>;
};
#endif

/ {
    EXT_POWER {
        /* nice_nano EXT_VCC rail — powers the trackpoint directly (3.3V) */
        control-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
        init-delay-ms = <500>;
    };
};
