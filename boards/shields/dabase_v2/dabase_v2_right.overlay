 *
 * ble-azoteq-tps43: Azoteq TPS43 touchpad on the right half.
 * Replaces the direct PS/2 TrackPoint (Exp69..Exp82). See
 * dabase-v2-right-tps43.dtsi for wiring and driver notes.
 */

#include "dabase_v2.dtsi"
#include "dabase-v2-right-tps43.dtsi"
#include <behaviors.dtsi>

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    diode-direction = "col2row";
    col-gpios
        = <&gpio0 2  GPIO_ACTIVE_HIGH>
        , <&gpio0 29 GPIO_ACTIVE_HIGH>
        , <&gpio0 9  GPIO_ACTIVE_HIGH>
        , <&gpio1 0  GPIO_ACTIVE_HIGH>
        , <&gpio0 11 GPIO_ACTIVE_HIGH>
        , <&gpio1 4  GPIO_ACTIVE_HIGH>
    ;

    row-gpios
        = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    ;
};

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        pad_split: pad_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    pad_listener: pad_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&tps43_trackpad>;
    };
};

#ifdef CONFIG_ZMK_SPLIT_ROLE_CENTRAL
/* Exp82: no dongle - the right half IS the split central, so the pointer
 * pipeline runs here: touch the pad -> tp_layer (5) for MB1/MB2/MB3,
 * hold J (6) -> scroll, hold K (7) -> volume.
 * Axis transform: none for now. The pad's switch-xy/invert-* devicetree
 * properties are applied inside the driver, so orientation is corrected
 * there (see dabase-v2-right-tps43.dtsi) and the processors stay simple. */
&pad_listener {
    status = "okay";
    /* Touch the pad -> layer 5 (tp_layer), giving MB1/MB2/MB3 on the right
     * thumb cluster. 150 ms idle timeout holds the layer through a normal
     * pause between touches yet drops it before a thumb keypress. NB: the
     * processor special-cases 0 as "no auto-release" (layer sticks). */
    input-processors = <&tp_temp_layer 5 150>;

    scroll_override {
        layers = <6>;
        /* Hold J -> finger movement becomes scroll (1:1: a trackpad emits
         * pixel-sized deltas, unlike the PS/2 TrackPoint's tiny counts). */
        input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
        process-next;
    };

    /* Hold K (layer 7) -> finger movement becomes volume.
     * Y-invert so up = louder. Keybind override first (process-next), then
     * scale X/Y to 0 so the cursor stays put on layer 7 (the keybind's STOP
     * is honored because volume_move_zero has no process-next). */
    volume_override {
        layers = <7>;
        input-processors = <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>, <&keybind_volume>;
        process-next;
    };

    volume_move_zero {
        layers = <7>;
        input-processors = <&zip_xy_scaler 0 1>;
    };
};

/ {
    tp_temp_layer: tp_temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        status = "okay";
    };

    /* Exp73: volume keybind - defined inline (the module's own dtsi pulls
     * <dt-bindings/zmk/input-processor-keybind.h>, missing from ZMK + the
     * module). Bindings order is [RIGHT, LEFT, DOWN, UP] per press_work_cb:
     * X mapped to &none so only Y produces volume. tick 32 = very slow. */
    keybind_volume: keybind_volume {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        mode = <0>;
        track_remainders;
        bindings = <&none>, <&none>, <&kp C_VOLUME_DOWN>, <&kp C_VOLUME_UP>;
        tick = <32>;
        wait-ms = <10>;
        tap-ms = <12>;
        threshold = <1>;
        max_threshold = <512>;
        max_pending_activations = <2>;
    };
};
#else
/* BLE peripheral: forward the pad's input to the central. */
&pad_split {
    device = <&tps43_trackpad>;
};
#endif

/ {
    EXT_POWER {
        /* nice_nano EXT_VCC rail: the pad is powered from it. Keep the
         * longer settle delay so the pad is up before the driver probes. */
        control-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
        init-delay-ms = <500>;
    };
};
