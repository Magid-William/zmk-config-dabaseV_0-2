/*
 * Copyright (c) 2020 The ZMK Contributors
 *
 * SPDX-License-Identifier: MIT
 *
 * Exp69 fresh: plain pointer listener on trackball_split — no
 * temp_layer / scroll / volume input processors (cursor-only bring-up).
 * Exp72: + temp_layer layer-toggle (tp_layer = MB1/MB2/MB3 on right thumb),
 * 400 ms idle timeout, as in origin/main.
 * Exp73: + scroll-layer-toggle (hold J, layer 6) + volume-layer-toggle
 * (hold K, layer 7) via layer-specific input-processor overrides.
 */

#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/input_transform.h>
#include "dabase_v2-layouts.dtsi"
#include <input/processors.dtsi>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &dabase_layout;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

	mock_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <12>;
        rows = <7>;

		map = <
            RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)     RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)     RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)     RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)     RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
        >;
	};

	left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        label = "LEFT_ENCODER";
        resolution = <4>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&trackball_split>;
        /* Exp72: touch the TP -> layer 5 (tp_layer) for 400 ms idle timeout,
         * giving MB1/MB2/MB3 on the right thumb cluster. Mirrors origin/main
         * (which used `<&tp_temp_layer 6 400>` on a 9-layer keymap; here
         * tp_layer is index 5 because scroll/volume layers aren't ported). */
        input-processors = <&tp_temp_layer 5 400>;

        /* Exp73: hold J (layer 6) -> trackpoint tilt becomes scroll.
         * Y-invert matches the natural-up mapping; process-next keeps the
         * touch-toggle (tp_temp_layer) active so MB1/2/3 work while
         * scroll-holding. Exp74: deltas are PowerCurve-shaped on the right
         * half again (sens 0.5x), so 1:2 may need retuning. */
        scroll_override {
            layers = <6>;
            input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>, <&zip_scroll_scaler 1 2>;
            process-next;
        };

        /* Exp73: hold K (layer 7) -> trackpoint tilt becomes volume.
         * Y-invert so up = louder (mirrors scroll/Exp51). Keybind override
         * first (process-next), then scale X/Y to 0 so the cursor stays put
         * on layer 7 (Exp51 lesson: the zero scaler without process-next is
         * what actually eats the leftover movement — the keybind's STOP is
         * honored only because volume_move_zero has no process-next). */
        volume_override {
            layers = <7>;
            input-processors = <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>, <&keybind_volume>;
            process-next;
        };

        volume_move_zero {
            layers = <7>;
            input-processors = <&zip_xy_scaler 0 1>;
        };
    };

    tp_temp_layer: tp_temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        status = "okay";
    };

    /* Exp73: volume keybind — defined inline (the module's own dtsi pulls
     * <dt-bindings/zmk/input-processor-keybind.h>, missing from ZMK + the
     * module). Bindings order is [RIGHT, LEFT, DOWN, UP] per press_work_cb:
     * X mapped to &none so only Y produces volume. tick 32 = very slow,
     * ~3x slower than scroll (Exp51 tuning). */
    keybind_volume: keybind_volume {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        mode = <0>;
        track_remainders;
        bindings = <&none>, <&none>, <&kp C_VOLUME_DOWN>, <&kp C_VOLUME_UP>;
        tick = <32>;
        wait-ms = <10>;
        tap-ms = <12>;
        threshold = <1>;
        max_threshold = <512>;
        max_pending_activations = <2>;
    };
};

&dabase_layout {
    transform = <&mock_transform>;
};
