#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/input/input-event-codes.h>
#include "dabase_v2-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &dabase_layout;
    };

    mouse_xy_swap: mouse_xy_swap {
        compatible = "zmk,input-processor-transform";
        #input-processor-cells = <1>;
        x-codes = <INPUT_REL_X>;
        y-codes = <INPUT_REL_Y>;
    };

    mouse_layer_toggle: mouse_layer_toggle {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

	mock_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <12>;
        rows = <7>;

		map = <
            RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)     RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)     RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)     RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)     RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
        >;
	};

	left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        label = "LEFT_ENCODER";
        resolution = <4>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };
    mouse_ps2_proxy: mouse_ps2_proxy@0 {
        compatible = "zmk,input-split";
        status = "okay";
        reg = <0 1>;
    };
    mouse_ps2_listener_central: mouse_ps2_listener_central {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&mouse_ps2_proxy>;
        input-processors = <&zip_zxy>,
                          <&mouse_xy_swap INPUT_TRANSFORM_XY_SWAP>,
                          <&mouse_layer_toggle 3 500>;
    };
};

#include <input/processors/xyz.dtsi>

&dabase_layout {
    transform = <&mock_transform>;
};
