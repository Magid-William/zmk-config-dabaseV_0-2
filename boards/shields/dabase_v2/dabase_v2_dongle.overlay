 *
 * Exp69 fresh: plain pointer listener on trackball_split — no
 * temp_layer / scroll / volume input processors (cursor-only bring-up).
 * Exp72: + temp_layer layer-toggle (tp_layer = MB1/MB2/MB3 on right thumb),
 * 500 ms idle timeout, as in origin/main.
 */

#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include "dabase_v2-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &dabase_layout;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

	mock_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <12>;
        rows = <7>;

		map = <
            RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)     RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)     RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)     RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)     RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
        >;
	};

	left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        label = "LEFT_ENCODER";
        resolution = <4>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&trackball_split>;
        /* Exp72: touch the TP -> layer 5 (tp_layer) for 500 ms idle timeout,
         * giving MB1/MB2/MB3 on the right thumb cluster. Mirrors origin/main
         * (which used `<&tp_temp_layer 6 500>` on a 9-layer keymap; here
         * tp_layer is index 5 because scroll/volume layers aren't ported). */
        input-processors = <&tp_temp_layer 5 500>;
    };

    tp_temp_layer: tp_temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        status = "okay";
    };
};

&dabase_layout {
    transform = <&mock_transform>;
};